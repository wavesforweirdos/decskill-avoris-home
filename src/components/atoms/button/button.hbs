{{#if href}}
<a class="button button--{{variant}} button--{{size}}{{#if block}} button--block{{/if}}{{#if class}} {{class}}{{/if}}" href="{{href}}">{{label}}</a>
{{else}}
<button class="button button--{{variant}} button--{{size}}{{#if block}} button--block{{/if}}{{#if class}} {{class}}{{/if}}" type="button"{{#if disabled}} disabled{{/if}}>{{label}}</button>
{{/if}}
