<span class="info-tooltip{{#if class}} {{class}}{{/if}}">
  <button class="info-tooltip__trigger" type="button" aria-label="{{label}}" aria-describedby="{{id}}">
    {{> atoms/icon/icon name="tooltip" size="sm"}}
  </button>
  <span class="info-tooltip__bubble" id="{{id}}" role="tooltip">{{text}}</span>
</span>
