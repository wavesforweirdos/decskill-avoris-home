<div class="filter-option">
  {{> atoms/checkbox/checkbox id=id name=id checked=checked class=false}}
  <label class="filter-option__label" for="{{id}}">
    <span class="filter-option__text">{{label}}</span>
    <span class="filter-option__ghost" aria-hidden="true">{{label}}</span>
  </label>
  {{#if tooltip}}
  {{> atoms/info-tooltip/info-tooltip owner=id label="Más información sobre" subject=label text=tooltip class=false}}
  {{/if}}
</div>
