<div class="card-group" role="group" aria-labelledby="{{groupId}}-title">
  {{> atoms/heading/heading level="3" variant="group" text=title id=titleId class="card-group__title"}}
  <ul class="card-group__list">
    <li>{{> molecules/trip-card/trip-card photo="card-bangkok" tag="Quads" city="Marruecos, África" days="9 días" title="Descubre Bangkok con Iberojet" price="248,00 €" popoverId=popoverBangkok groupTitle=title groupNumber=groupNumber position=1}}</li>
    <li>{{> molecules/trip-card/trip-card photo="card-desert" tag="Quads" city="Marruecos, África" days="9 días" title="Descubre Bangkok con Iberojet" price="248,00 €" popoverId=popoverDesert groupTitle=title groupNumber=groupNumber position=2}}</li>
    <li>{{> molecules/trip-card/trip-card photo="card-town" tag="Quads" city="Marruecos, África" days="9 días" title="Descubre Bangkok con Iberojet" price="248,00 €" popoverId=popoverTown groupTitle=title groupNumber=groupNumber position=3}}</li>
    {{#if more}}
    <li>{{> molecules/trip-card/trip-card photo="card-bangkok" tag="Quads" city="Marruecos, África" days="9 días" title="Descubre Bangkok con Iberojet" price="248,00 €" popoverId=popoverBangkokMore groupTitle=title groupNumber=groupNumber position=4}}</li>
    <li>{{> molecules/trip-card/trip-card photo="card-desert" tag="Quads" city="Marruecos, África" days="9 días" title="Descubre Bangkok con Iberojet" price="248,00 €" popoverId=popoverDesertMore groupTitle=title groupNumber=groupNumber position=5}}</li>
    <li>{{> molecules/trip-card/trip-card photo="card-town" tag="Quads" city="Marruecos, África" days="9 días" title="Descubre Bangkok con Iberojet" price="248,00 €" popoverId=popoverTownMore groupTitle=title groupNumber=groupNumber position=6}}</li>
    {{/if}}
  </ul>
</div>
