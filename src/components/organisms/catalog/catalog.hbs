<section class="catalog" aria-labelledby="catalog-title">
  {{> molecules/section-header/section-header title="Vive tus propias aventuras" subtitle="Para los que les gusta explorar y conocer mundo sin complejos" titleId="catalog-title"}}
  <div class="catalog__body">
    {{> atoms/filter-toggle/filter-toggle label="Ver filtros" popup="dialog" class="catalog__filters-toggle"}}
    {{> organisms/filters/filters}}
    <div class="catalog__groups">
      {{> organisms/card-group/card-group groupId="asia-1" groupNumber=1 titleId="asia-1-title" title="Asia" popoverBangkok="asia-1-bangkok" popoverDesert="asia-1-desert" popoverTown="asia-1-town"}}
      {{> organisms/card-group/card-group groupId="asia-2" groupNumber=2 titleId="asia-2-title" title="Asia" popoverBangkok="asia-2-bangkok" popoverDesert="asia-2-desert" popoverTown="asia-2-town" more=true popoverBangkokMore="asia-2-bangkok-more" popoverDesertMore="asia-2-desert-more" popoverTownMore="asia-2-town-more"}}
    </div>
  </div>
</section>
